# Copy to .env and change every value. Never commit .env.
POSTGRES_DB=procurax_db
POSTGRES_USER=procurax
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://procurax:change-me@postgres:5432/procurax_db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=/data/uploads
MODEL_STORE_DIR=/data/models
MAX_UPLOAD_MB=20
# LLM (optional until Phase 5 features are used)
# AI_PROVIDER: anthropic | groq
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SEED=42

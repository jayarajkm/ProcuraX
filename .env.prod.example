# Copy to .env.prod on the server, fill EVERY value, chmod 600. Never commit.
# generate secrets:  openssl rand -hex 32
DOMAIN=procurax.example.com
LETSENCRYPT_EMAIL=you@example.com
APP_VERSION=v1
POSTGRES_DB=procurax_db
POSTGRES_USER=procurax
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://procurax:<same-password>@postgres:5432/procurax_db
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=https://procurax.example.com
DOCS_ENABLED=true
# API worker processes. Each can hold the ~0.45 GB embedding model: use 1 on a 2 GB server, 2 on 4 GB.
UVICORN_WORKERS=1
UPLOAD_DIR=/data/uploads
MODEL_STORE_DIR=/data/models
MAX_UPLOAD_MB=20
# LLM: choose one provider and set only its key (keys stay on the server, never sent to the browser)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ---- Embeddings (RAG). local = sentence-transformers inside the container (~0.45 GB RAM per process).
# 1 GB server: set LOCAL_EMBEDDINGS=0 and a hosted provider (EMBEDDING_PROVIDER=openai or cohere). Dimension MUST be 384.
#   openai : EMBEDDING_MODEL=text-embedding-3-small  EMBEDDING_BASE_URL=https://api.openai.com/v1   (any OpenAI-compatible API works)
#   cohere : EMBEDDING_MODEL=embed-multilingual-light-v3.0   (384 dims; check the provider's current terms/limits)
LOCAL_EMBEDDINGS=1
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SEED=42

# ---- 1 GB SERVER PROFILE (uncomment). Containers are capped so one runaway process is OOM-killed alone instead of freezing the host.
# UVICORN_WORKERS=1
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# PG_SHARED_BUFFERS=64MB
# PG_MAX_CONNECTIONS=25
# POSTGRES_MEM=256m
# BACKEND_MEM=360m
# WORKER_MEM=180m
# NGINX_MEM=40m
# FRONTEND_MEM=40m
